{
  "name": "yushario",
  "version": "0.1.0",
  "description": "A local RPG town for your AI coding agents, with live activity, conversations, and embedded terminals.",
  "repository": { "type": "git", "url": "git+https://github.com/Morishita-mm/agent-character.git" },
  "homepage": "https://github.com/Morishita-mm/agent-character#readme",
  "bugs": { "url": "https://github.com/Morishita-mm/agent-character/issues" },
  "keywords": ["ai", "coding-agent", "claude-code", "pi", "codex", "rpg", "pixel-art", "terminal"],
  "author": "Morishita-mm",
  "license": "MIT",
  "bin": { "yushario": "scripts/yushario.mjs" },
  "files": ["dist/", "lib/", "adapters/claude-code/hook.mjs", "scripts/yushario.mjs", "LICENSE", "NOTICE"],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node scripts/build-server.mjs",
    "prepack": "npm run build",
    "start": "node scripts/yushario.mjs",
    "dev:relay": "NODE_ENV=development tsx src/server/relay.ts",
    "dev:web": "vite",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.2.0-beta.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true
  }
}
